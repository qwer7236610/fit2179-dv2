{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Figure 10 - Choropleth: home care rate per 100 aged 65+, by SA3.",
  "title": {
    "text": "Where home care runs deepest",
    "anchor": "middle",
    "fontSize": 18
  },
  "width": 720,
  "height": 620,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -28
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/SA3_2016_AUST.json",
        "format": {
          "type": "topojson",
          "feature": "SA3_2016_AUST"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f2f2f2",
        "stroke": "white",
        "strokeWidth": 0.4
      },
      "encoding": {
        "tooltip": {
          "value": "No data"
        }
      }
    },
    {
      "data": {
        "url": "data/SA3_2016_AUST.json",
        "format": {
          "type": "topojson",
          "feature": "SA3_2016_AUST"
        }
      },
      "transform": [
        {
          "lookup": "properties.SA3_CODE16",
          "from": {
            "data": {
              "url": "data/sa3_master.csv"
            },
            "key": "sa3_code",
            "fields": [
              "sa3_name",
              "home_per_100_65plus",
              "chsp_recipients",
              "pop_65plus",
              "low_base"
            ]
          }
        },
        {
          "filter": "isValid(datum.home_per_100_65plus) && datum.pop_65plus > 0 && datum.home_per_100_65plus < 100"
        },
        {
          "calculate": "datum.home_per_100_65plus < 14 ? '< 14' : datum.home_per_100_65plus < 16.4 ? '14\\u201316' : datum.home_per_100_65plus < 18.6 ? '16\\u201319' : datum.home_per_100_65plus < 21.2 ? '19\\u201321' : '21+'",
          "as": "rate_band"
        },
        {
          "calculate": "datum.low_base==true || datum.low_base=='True' ? 'Small 85+ base \\u2014 interpret with caution' : ''",
          "as": "base_note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "field": "rate_band",
          "type": "ordinal",
          "title": [
            "Home care users",
            "per 100 aged 65+"
          ],
          "sort": [
            "< 14",
            "14–16",
            "16–19",
            "19–21",
            "21+"
          ],
          "scale": {
            "domain": [
              "< 14",
              "14–16",
              "16–19",
              "19–21",
              "21+"
            ],
            "range": [
              "#f6f0fd",
              "#d3b8f7",
              "#ae6af5",
              "#8537d9",
              "#5b1ba3"
            ]
          },
          "legend": {
            "orient": "right",
            "symbolType": "square",
            "symbolSize": 150,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "offset": 8,
            "rowPadding": 3
          }
        },
        "tooltip": [
          {
            "field": "sa3_name",
            "type": "nominal",
            "title": "Area"
          },
          {
            "field": "home_per_100_65plus",
            "type": "quantitative",
            "title": "Home care per 100 (65+)",
            "format": ".1f"
          },
          {
            "field": "chsp_recipients",
            "type": "quantitative",
            "title": "Home care users",
            "format": ","
          },
          {
            "field": "base_note",
            "type": "nominal",
            "title": " "
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Helvetica, Arial, sans-serif"
  }
}